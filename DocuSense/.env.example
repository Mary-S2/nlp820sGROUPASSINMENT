# DocuSense Environment Configuration Template
# Copy this file to .env and insert your API keys if you wish to enable hosted LLM generation.
# By default, DocuSense runs in 'extractive_fallback' mode which requires NO external API keys!

# LLM Provider selection: "gemini", "openai", "groq", "huggingface", or "extractive_fallback"
LLM_PROVIDER=extractive_fallback

# Optional API Keys for Generative RAG:
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
HF_TOKEN=your_huggingface_token_here

# Gradio Public Link (set to True when running in Google Colab for temporary share link)
GRADIO_SHARE=False
